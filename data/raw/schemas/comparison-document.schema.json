{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skn35-art-tracker:comparison-document:0.2",
  "title": "작가 비교 문서",
  "description": "documents와 document_artists 적재 전 검증용 작가 비교 문서 스키마",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_status", "collected_at", "document"],
  "properties": {
    "schema_version": { "const": "0.2-draft" },
    "record_status": { "type": "string", "minLength": 1 },
    "collected_at": { "type": "string", "format": "date" },
    "document": { "$ref": "#/$defs/comparisonDocument" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "source_url", "used_for"],
      "properties": {
        "source_name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "used_for": { "type": "string", "minLength": 1 }
      }
    },
    "comparisonDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_key",
        "doc_type",
        "title",
        "year",
        "artist_slugs",
        "artwork_slug",
        "content",
        "source_url",
        "source_name",
        "sources",
        "license",
        "content_author",
        "copyright_notice",
        "source_rights_note",
        "review_status"
      ],
      "properties": {
        "document_key": { "$ref": "#/$defs/slug" },
        "doc_type": { "const": "artist_comparison" },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "year": { "type": "string", "minLength": 1 },
        "artist_slugs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "artwork_slug": { "type": "null" },
        "content": { "type": "string", "minLength": 500 },
        "source_url": { "type": "string", "format": "uri" },
        "source_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/source" }
        },
        "license": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_author": { "type": "string", "minLength": 1 },
        "copyright_notice": { "type": "string", "minLength": 1 },
        "source_rights_note": { "type": "string", "minLength": 1 },
        "review_status": { "type": "string", "minLength": 1 }
      }
    }
  }
}
