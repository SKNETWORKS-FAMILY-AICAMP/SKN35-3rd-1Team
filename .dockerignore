# Only what the backend image needs (infra/backend.Dockerfile). Keeps .env,
# .venv, raw data and the frontend out of the build context.
**
!pyproject.toml
!uv.lock
!backend/
backend/tests/
**/__pycache__/
**/.pytest_cache/

!data/
!data/processed/
!data/processed/*.jsonl
!data/processed/_SUCCESS.json
