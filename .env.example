# TiDB Cloud connection (copy values from Connect > SQLAlchemy > PyMySQL)
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USERNAME=<cluster-prefix>.root
TIDB_PASSWORD=
TIDB_DATABASE=3rd_project


# A complete SQLAlchemy URL can be used instead of the five fields above.
# TIDB_DATABASE_URL=mysql+pymysql://user:password@host:4000/3rd_project
