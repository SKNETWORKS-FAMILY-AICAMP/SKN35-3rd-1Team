# TiDB Cloud connection (copy values from Connect > SQLAlchemy > PyMySQL)
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USERNAME=<cluster-prefix>.root
TIDB_PASSWORD=
TIDB_DATABASE=3rd_project


# A complete SQLAlchemy URL can be used instead of the five fields above.
# TIDB_DATABASE_URL=mysql+pymysql://user:password@host:4000/3rd_project

# Backend authentication. dev maps all bearer tokens to one development user.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=skn35-3rd-1team
# For Firebase mode, use ONE server-only credential method:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# Never put either credential in frontend/ or Vercel build variables.
CORS_ORIGINS=https://artlog-skn35-1team.vercel.app

# OpenAI embeddings (scripts.build_chunks, chatbot question embedding)
OPENAI_API_KEY=
# Must match the VECTOR(1536) column; changing it requires a migration and a full rebuild.
EMBEDDING_MODEL=text-embedding-3-small

# Chroma (search copy of TiDB vectors; filled by scripts.sync_chroma)
# Railway public domain: CHROMA_HOST=<domain>, CHROMA_PORT=443, CHROMA_SSL=true
# Same Railway project (private network): CHROMA_HOST=<service>.railway.internal, CHROMA_PORT=8000
# Local folder instead of a server: leave CHROMA_HOST empty and set CHROMA_PATH=data/chroma
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
# CHROMA_PATH=
# Separate dev and demo collections, e.g. chunks_dev / chunks
CHROMA_CHUNKS_COLLECTION=chunks
CHROMA_ARTWORKS_COLLECTION=artworks
